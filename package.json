{
  "name": "Tasks",
  "productName": "Tasks",
  "description": "轻量时间管理助手",
  "keywords": [],
  "main": "./main.js",
  "version": "10.0.0",
  "author": "Zongyi",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "^26.15.6"
  },
  "build": {
    "appId": "com.zongyi.pjalpha.tasks",
    "productName": "Tasks",
    "protocols": [
      {
        "name": "Tasks Protocol",
        "schemes": [
          "tasks"
        ]
      }
    ],
    "files": [
      "main.js",
      "main_worker.js",
      "sync_worker.js",
      "data_worker.js",
      "preload.js",
      "splash.html",
      "wrapper.html",
      "Home.html",
      "Focus.html",
      "Account.html",
      "settings.html",
      "TaskHub.html",
      "TaskTimer.html",
      "TaskFlow.html",
      "version.json",
      "Icon.ico",
      "Icon.png",
      "Icon_sm.png",
      "assets/chart.umd.min.js",
      "assets/flatpickr.min.css",
      "assets/flatpickr.min.js",
      "assets/fflate.min.js",
      "assets/cropper.min.js",
      "assets/cropper.min.css",
      "fonts/OPPO Sans 4.0.ttf",
      "fonts/Monaspace Neon Var.ttf",
      "icons/TaskHub.png",
      "icons/TaskTimer.png",
      "icons/TaskFlow.png",
      "icons/Avatar.png",
      "icons/Bubbles.png",
      "icons/Chart.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Zongyil",
        "repo": "Tasks"
      }
    ],
    "win": {
      "icon": "Tasks.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar.bmp",
      "license": "LICENSE.txt",
      "differentialPackage": true
    }
  }
}
